DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
IVA_PSEUDONYM_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
REDIS_URL=
CELERY_BROKER_URL=
CONVERSATION_REDIS_URL=
CONVERSATION_SESSION_TTL_SECONDS=
IVA_BACKEND_ADAPTER=apps.conversations.fake_backend.FakeBackend
# The AI Planner page (built on the website). Unset or non-https skips the welcome
# CTA and menu link and falls straight through to the main menu.
IVA_PLANNER_URL=
# The website's full-menu page (https only). Unset or non-https hides the main-menu
# "See full menu on website" option.
IVA_WEBSITE_SHOP_URL=
# Native WhatsApp catalog id; an order from another catalog is ignored. Empty = no check.
IVA_CATALOG_ID=
IVA_CATALOG_ORDER_MAX_QTY=10
LOG_LEVEL=INFO
# Groq LLM fallback (off by default). Put the key in your private .env only.
IVA_LLM_ENABLED=false
GROQ_API_KEY=
IVA_LLM_MODEL=openai/gpt-oss-20b
IVA_LLM_TIMEOUT_S=4
IVA_LLM_MIN_CONFIDENCE=0.7
IVA_LLM_DAILY_CAP=500
IVA_LLM_CUSTOMER_PER_MINUTE=3
IVA_LLM_BREAKER_FAILURES=5
IVA_LLM_BREAKER_COOLDOWN_S=120
# Abuse and cost guards for the model (limit MODEL CALLS only; code-only replies never depend on
# them). Longer messages are skipped, never cut. A token cap left empty/0 uses a built-in default
# below the provider's free-tier limits; it is never unlimited. Set the daily cap explicitly.
IVA_LLM_MAX_INPUT_CHARS=500
IVA_LLM_DAILY_TOKEN_CAP=
IVA_LLM_MINUTE_TOKEN_CAP=
IVA_LLM_MINUTE_CAP=20
IVA_LLM_CUSTOMER_DAILY_CAP=30
IVA_LLM_CUSTOMER_BUDGET_SHARE_PCT=5
# Auto-trip of the runtime kill switch on a high failure / validation-rejection rate.
IVA_LLM_TRIP_WINDOW_MIN=5
IVA_LLM_TRIP_MIN_CALLS=10
IVA_LLM_TRIP_FAILURE_RATE=0.5
IVA_LLM_TRIP_REJECT_RATE=0.5
IVA_LLM_TRIP_COOLOFF_S=900
# Grounded recommendations (needs IVA_LLM_ENABLED); off by default.
IVA_LLM_RECOMMEND_ENABLED=false
IVA_LLM_RECOMMEND_MAX_PICKS=4
# Emergency keyword check (on by default). Contact text is yours: leave empty if unsure.
IVA_SAFETY_KEYWORDS_ENABLED=true
# Code-only routes: price limits, diet words, protein sort, goal words, product facts, label and
# plan requests. Independent of every IVA_LLM_* setting, the Groq key and the kill switch.
IVA_CODE_CONSTRAINTS_ENABLED=true
IVA_EMERGENCY_CONTACT_TEXT=
IVA_FUZZY_CART_CONFIRM=true
IVA_FUZZY_NUMBER_GUARD=true
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_GRAPH_BASE_URL=
IVA_MESSAGE_RETENTION_DAYS=
# https base URL the Fake Backend joins with a product's relative image path to build
# ProductSummary/ProductDetail.image_url. Unset or non-https: no images (text-only cards).
IVA_PRODUCT_IMAGE_BASE_URL=
IVA_RATE_LIMIT_PER_MINUTE=
IVA_CUSTOMER_LOCK_WAIT_SECONDS=
# Seconds a buttons message waits for the status callback of the carousel/image card before
# it (0 = don't wait; default 5) and the status that ends the wait (sent|delivered).
IVA_ORDER_WAIT_SECONDS=
# Development only: JSON file that keeps the Fake Backend's customer state across restarts
# (e.g. .local-data/fake_backend.json). Empty = in memory only. Production refuses it.
IVA_FAKE_BACKEND_STATE_FILE=
IVA_ORDER_WAIT_STATUS=
IVA_CELERY_POLLING_INTERVAL_SECONDS=
IVA_CELERY_HEALTH_CHECK_INTERVAL_SECONDS=
# Development only: processes the webhook synchronously (no Celery worker/broker
# needed). Production refuses to start with this true.
IVA_INLINE_PROCESSING=false
# Order-status notifications pushed by the backend. The secret authenticates
# POST /webhooks/whatsapp/order-events/ (header X-IVA-Events-Secret); empty = rejects all.
IVA_ORDER_EVENTS_SECRET=
# JSON: {"CONFIRMED": {"en": "<approved template name>", "hi": "...", "te": "..."}, ...}.
# Needed to notify customers outside the 24-hour window; unset = those are not sent.
IVA_ORDER_STATUS_TEMPLATES_JSON=

# ---------------------------------------------------------------------------
# Development / test-only variables. NEVER set these in production. They are
# commented out on purpose: an EMPTY line here would be loaded into the process
# environment, and an empty DJANGO_ENV_FILE makes settings skip .env entirely
# (including for runserver's reload process). Uncomment only to use one, with a
# real value of your own; never commit a real value.
# ---------------------------------------------------------------------------
# Dev only: the customer WhatsApp ID that `manage.py replay_order` simulates catalog
# orders from when --to is not given (a number you own; never commit a real one).
# IVA_REPLAY_WA_ID=
# Test only: path of the env file settings read instead of .env. The test suite points it
# at a missing file so only the real environment is used. Leave unset for normal use.
# DJANGO_ENV_FILE=
# Test only: dotted path of a ContractHarness so the backend contract tests run against a
# real adapter instead of the Fake Backend (see apps/conversations/tests/contract/harness.py).
# IVA_CONTRACT_HARNESS=
# Test only: set to 0 by one test to prove HTTPS verification cannot be switched off by
# Python's global opt-out. Never set this anywhere: IVA's HTTP client ignores it on purpose.
# PYTHONHTTPSVERIFY=
