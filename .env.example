DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
IVA_PSEUDONYM_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
REDIS_URL=
CELERY_BROKER_URL=
CONVERSATION_REDIS_URL=
CONVERSATION_SESSION_TTL_SECONDS=
IVA_BACKEND_ADAPTER=apps.conversations.fake_backend.FakeBackend
# The AI Planner page (built on the website). Unset or non-https skips the welcome
# CTA and menu link and falls straight through to the main menu.
IVA_PLANNER_URL=
# The website's full-menu page (https only). Unset or non-https hides the main-menu
# "See full menu on website" option.
IVA_WEBSITE_SHOP_URL=
# Native WhatsApp catalog id; an order from another catalog is ignored. Empty = no check.
IVA_CATALOG_ID=
IVA_CATALOG_ORDER_MAX_QTY=10
LOG_LEVEL=INFO
# Groq LLM fallback (off by default). Put the key in your private .env only.
IVA_LLM_ENABLED=false
GROQ_API_KEY=
IVA_LLM_MODEL=openai/gpt-oss-20b
IVA_LLM_TIMEOUT_S=4
IVA_LLM_MIN_CONFIDENCE=0.7
IVA_LLM_DAILY_CAP=500
IVA_LLM_CUSTOMER_PER_MINUTE=3
IVA_LLM_BREAKER_FAILURES=5
IVA_LLM_BREAKER_COOLDOWN_S=120
# Grounded recommendations (needs IVA_LLM_ENABLED); off by default.
IVA_LLM_RECOMMEND_ENABLED=false
IVA_LLM_RECOMMEND_MAX_PICKS=4
# Emergency keyword check (on by default). Contact text is yours: leave empty if unsure.
IVA_SAFETY_KEYWORDS_ENABLED=true
IVA_EMERGENCY_CONTACT_TEXT=
IVA_FUZZY_CART_CONFIRM=true
IVA_FUZZY_NUMBER_GUARD=true
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_GRAPH_BASE_URL=
IVA_MESSAGE_RETENTION_DAYS=
# https base URL the Fake Backend joins with a product's relative image path to build
# ProductSummary/ProductDetail.image_url. Unset or non-https: no images (text-only cards).
IVA_PRODUCT_IMAGE_BASE_URL=
IVA_RATE_LIMIT_PER_MINUTE=
IVA_CUSTOMER_LOCK_WAIT_SECONDS=
# Seconds a buttons message waits for the status callback of the carousel/image card before
# it (0 = don't wait; default 5) and the status that ends the wait (sent|delivered).
IVA_ORDER_WAIT_SECONDS=
# Development only: JSON file that keeps the Fake Backend's customer state across restarts
# (e.g. .local-data/fake_backend.json). Empty = in memory only. Production refuses it.
IVA_FAKE_BACKEND_STATE_FILE=
IVA_ORDER_WAIT_STATUS=
IVA_CELERY_POLLING_INTERVAL_SECONDS=
IVA_CELERY_HEALTH_CHECK_INTERVAL_SECONDS=
# Development only: processes the webhook synchronously (no Celery worker/broker
# needed). Production refuses to start with this true.
IVA_INLINE_PROCESSING=false
